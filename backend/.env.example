DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=financeocr
DB_USER=financeocr
DB_PASS=changeme

# openssl rand -base64 48
JWT_SECRET=changeme
JWT_TTL_DAYS=30

# Must match the frontend's VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com

# Absolute path to the Portuguese tessdata dir, only needed if NOT relying on
# the system tesseract-ocr-por package (leave empty to use the system default)
TESSDATA_DIR=

# Absolute path outside the web-exposed docroot
UPLOADS_DIR=../uploads
