DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=financeocr
DB_USER=financeocr
DB_PASS=changeme

# openssl rand -base64 48
JWT_SECRET=changeme
JWT_TTL_DAYS=30

# Must match the frontend's VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com

# Absolute path to the Portuguese tessdata dir, only needed if NOT relying on
# the system tesseract-ocr-por package (leave empty to use the system default)
TESSDATA_DIR=

# Absolute path outside the web-exposed docroot
UPLOADS_DIR=../uploads

# Opcional: fallback pago de IA (visão) quando o parser local (regex) não
# consegue extrair os dados com confiança (sem NIF, sem itens ou total 0).
# Deixa vazio para desativar o fallback e usar sempre só o parser local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
